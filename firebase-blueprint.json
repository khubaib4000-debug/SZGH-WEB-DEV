{
  "entities": {
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Live product listing, stock quantity, price, 4-to-6 image gallery (including A+B / C+E panel pictures), and default display image index managed by SZGH Pakistan administrators.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "description": "Unique product identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "modelNumber": {
          "type": "string",
          "description": "Official SZGH model number.",
          "minLength": 1,
          "maxLength": 160
        },
        "title": {
          "type": "string",
          "description": "Product display title (can be empty if not provided in Excel stock list).",
          "minLength": 0,
          "maxLength": 300
        },
        "category": {
          "type": "string",
          "description": "Primary storefront category.",
          "enum": ["Controllers", "Motors", "Machines", "Robots"]
        },
        "subcategory": {
          "type": "string",
          "description": "Technical subcategory label (can be empty if not provided in Excel stock list).",
          "minLength": 0,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Product technical description including ATC / Absolute support and specifications.",
          "minLength": 0,
          "maxLength": 2500
        },
        "price": {
          "type": "integer",
          "description": "Live unit price in PKR."
        },
        "stockCount": {
          "type": "integer",
          "description": "Current available physical stock count."
        },
        "stockStatus": {
          "type": "string",
          "description": "Availability status badge.",
          "enum": ["In Stock", "Low Stock", "Pre-Order"]
        },
        "defaultImageIndex": {
          "type": "integer",
          "description": "Index (0 to 5) of the highlighted default image displayed on product cards."
        },
        "images": {
          "type": "array",
          "description": "Array of up to 6 product image URLs or compressed data URLs (4 series images + up to 2 panel images)."
        },
        "updatedBy": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator who last updated the listing.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest update."
        }
      },
      "required": [
        "productId",
        "modelNumber",
        "title",
        "category",
        "subcategory",
        "description",
        "price",
        "stockCount",
        "stockStatus",
        "defaultImageIndex",
        "images",
        "updatedBy",
        "updatedAt"
      ]
    },
    "CatalogManifest": {
      "title": "CatalogManifest",
      "description": "Manifest of custom product IDs added by administrators so the storefront can subscribe via single-document get without list queries.",
      "type": "object",
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customProductIds": {
          "type": "array",
          "description": "Bounded list of custom product document IDs."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["manifestId", "customProductIds", "updatedBy", "updatedAt"]
    },
    "CustomerOrder": {
      "title": "CustomerOrder",
      "description": "Complete B2B customer order record submitted directly at checkout including mandatory NTN No., 18% Sales Tax for Official Tax Invoices, and Cash on Pick Up or Online Bank Transfer selection.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contactName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 150
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "ntnNumber": {
          "type": "string",
          "description": "Customer National Tax Number (NTN No., required when Sales Tax Invoice is selected).",
          "minLength": 0,
          "maxLength": 60
        },
        "strnNumber": {
          "type": "string",
          "description": "Optional Sales Tax Registration Number or CNIC.",
          "minLength": 0,
          "maxLength": 60
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "address": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "orderNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 600
        },
        "invoiceType": {
          "type": "string",
          "enum": [
            "1- Cash (Cash on Pick Up)",
            "2- Online (UBL Bank Transfer)",
            "3- Sales Tax Invoice (18% GST)",
            "Official Tax Invoice (18% GST)",
            "Standard Commercial Receipt"
          ]
        },
        "paymentMethod": {
          "type": "string",
          "enum": [
            "1- Cash (Cash on Pick Up)",
            "2- Online (UBL Bank Transfer)",
            "3- Sales Tax Invoice (18% GST)",
            "Cash on Pick Up (Lahore Facility)",
            "Online Bank Transfer (UBL)",
            "Sales Tax Invoice (18% GST)"
          ]
        },
        "transactionRef": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "itemsSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "subtotalPKR": {
          "type": "integer"
        },
        "salesTaxRate": {
          "type": "integer",
          "enum": [0, 18]
        },
        "salesTaxPKR": {
          "type": "integer"
        },
        "totalPKR": {
          "type": "integer"
        },
        "orderStatus": {
          "type": "string",
          "enum": ["New Order", "Confirmed", "Ready for Pick Up", "Completed", "Cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "customerUid",
        "companyName",
        "contactName",
        "email",
        "phone",
        "ntnNumber",
        "strnNumber",
        "city",
        "address",
        "orderNotes",
        "invoiceType",
        "paymentMethod",
        "transactionRef",
        "itemsSummary",
        "subtotalPKR",
        "salesTaxRate",
        "salesTaxPKR",
        "totalPKR",
        "orderStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "OrderManifest": {
      "title": "OrderManifest",
      "description": "Manifest of submitted order IDs so administrators can subscribe to individual order documents via single-document get without list queries.",
      "type": "object",
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "orderIds": {
          "type": "array",
          "description": "Bounded list of submitted order document IDs."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["manifestId", "orderIds", "updatedBy", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized SZGH Pakistan inventory administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Customer CNC Retrofitting or Machine Maintenance booking request with up to 6 attached machine inspection photos shared via WhatsApp.",
      "type": "object",
      "properties": {
        "bookingId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceType": {
          "type": "string",
          "enum": ["Retrofitting", "Maintenance"]
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "contactNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "photoTitles": {
          "type": "array",
          "description": "Labels for each attached machine inspection photo."
        },
        "photos": {
          "type": "array",
          "description": "Array of 1 to 6 compressed machine inspection photo data URLs."
        },
        "status": {
          "type": "string",
          "enum": ["New Request", "Reviewed", "Engineer Dispatched", "Completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "bookingId",
        "serviceType",
        "customerName",
        "contactNumber",
        "address",
        "description",
        "photoTitles",
        "photos",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookingManifest": {
      "title": "BookingManifest",
      "description": "Manifest of submitted retrofitting and maintenance booking IDs.",
      "type": "object",
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingIds": {
          "type": "array",
          "description": "Bounded list of service booking document IDs."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["manifestId", "bookingIds", "updatedAt"]
    }
  },
  "firestore": {
    "/inventory/{productId}": {
      "schema": {
        "$ref": "#/entities/InventoryItem"
      },
      "description": "Stores live product details, stock quantities, PKR prices, 4-to-6 photo arrays, and default image index for each product ID."
    },
    "/catalog_index/{manifestId}": {
      "schema": {
        "$ref": "#/entities/CatalogManifest"
      },
      "description": "Stores the active manifest of custom product IDs added by administrators."
    },
    "/orders/{orderId}": {
      "schema": {
        "$ref": "#/entities/CustomerOrder"
      },
      "description": "Stores complete B2B customer orders submitted directly on the website."
    },
    "/order_index/{manifestId}": {
      "schema": {
        "$ref": "#/entities/OrderManifest"
      },
      "description": "Stores the active manifest of submitted order IDs."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Trusted administrator lookup collection."
    },
    "/service_bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/ServiceBooking"
      },
      "description": "Stores customer retrofitting and maintenance requests along with attached machine inspection photos."
    },
    "/booking_index/{manifestId}": {
      "schema": {
        "$ref": "#/entities/BookingManifest"
      },
      "description": "Stores the active manifest of service booking IDs."
    }
  }
}
